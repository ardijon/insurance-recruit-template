# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local SQLite database — one file per deployment, never committed (see edge.md §2/§3)
/data/*.db
/data/*.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts

# tunnel / demo files
cloudflared.exe
cloudflared-config.yml
ngrok.exe
start-demo.bat
start-demo.ps1
tunnel*.log
dev.log
lt.log
Insurance
