# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local SQLite database — one file per deployment, never committed (see edge.md §2/§3)
/data/*.db
/data/*.db-journal
/data/*.db-wal
/data/*.db-shm

# any other local sqlite databases (e.g. tooling/debug)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# freebuff debug database
/freebuff/

# uploaded images — regenerated per deployment
/public/uploads/**
!/public/uploads/visual-story/

# typescript
*.tsbuildinfo
next-env.d.ts

# tunnel / demo files
cloudflared.exe
cloudflared-config.yml
ngrok.exe
start-demo.bat
start-demo.ps1
tunnel*.log
dev.log
lt.log
Insurance

# Local Netlify folder
.netlify

# Cloudflare
.wrangler/
.dev.vars

# Cloudflare
.wrangler/
.dev.vars
